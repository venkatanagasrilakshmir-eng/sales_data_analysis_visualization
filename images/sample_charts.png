import matplotlib.pyplot as plt
import seaborn as sns
import os

os.makedirs("images", exist_ok=True)

# Example: combined visualization figure
fig, axes = plt.subplots(2, 2, figsize=(12, 10))

# 1. Product Revenue
product_revenue = df.groupby("Product")["Revenue"].sum()
axes[0, 0].bar(product_revenue.index, product_revenue.values, color="skyblue")
axes[0, 0].set_title("Revenue by Product")
axes[0, 0].tick_params(axis='x', rotation=45)

# 2. Product Line Mean Revenue
product_line = df.groupby("Product_Line")["Revenue"].mean()
axes[0, 1].bar(product_line.index, product_line.values, color="orange")
axes[0, 1].set_title("Product Line Avg Revenue")
axes[0, 1].tick_params(axis='x', rotation=45)

# 3. Product Type Quantity
product_type = df.groupby("Product_Type")["Quantity"].mean()
axes[1, 0].bar(product_type.index, product_type.values, color="green")
axes[1, 0].set_title("Product Type Avg Quantity")
axes[1, 0].tick_params(axis='x', rotation=45)

# 4. Category Revenue
category = df.groupby("Category")["Revenue"].sum()
axes[1, 1].bar(category.index, category.values, color="purple")
axes[1, 1].set_title("Category Revenue")

plt.tight_layout()

# SAVE FINAL IMAGE (THIS IS YOUR sample_charts.png)
plt.savefig("images/sample_charts.png")

plt.show()
